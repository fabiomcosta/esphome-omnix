# Copy this file to `secrets.yaml` (gitignored) and fill in your own values.
#
# Generate the random ones with:
#   api_key:      openssl rand -base64 32   (also used for OTA)
#   ap_password:  openssl rand -hex 8
#
# Everything here is unique per install. The `api_key` is the value you enter
# in Home Assistant when adding the ESPHome device.

wifi_ssid: "REPLACE_WITH_WIFI_SSID"
wifi_password: "REPLACE_WITH_WIFI_PASSWORD"

api_key: "REPLACE_WITH_openssl_rand_base64_32"
ap_password: "REPLACE_WITH_openssl_rand_hex_8"

# YOUR pump's BLE MAC (optional fallback; leave blank to discover/select the
# pump from Home Assistant instead of hardcoding it).
pump_mac_address: "REPLACE_WITH_YOUR_PUMP_MAC"

# The pump's 16-byte security key (from the Hayward app). If set here it
# is compiled into the firmware, exactly like api_key above. Leave it "" to
# instead enter it once from Home Assistant with the "Security Key" text
# entity, where the device stores it in its own flash (NVS).
pump_security_key: "REPLACE_WITH_SECURITY_KEY"
